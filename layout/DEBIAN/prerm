#!/bin/sh
launchctl unload /var/jb/Library/LaunchDaemons/com.johndie.triggrd.plist 2>/dev/null
# Take the Triggr app off the Home Screen before its files go.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	for p in /var/jb/Applications/TriggrApp.app /Applications/TriggrApp.app; do
		[ -d "$p" ] && uicache -u "$p" >/dev/null 2>&1
	done
fi
exit 0
